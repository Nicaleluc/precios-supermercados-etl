# Copiar a .env y completar. NUNCA commitear .env.

# SQL SERVER (tablas dbo.D_Precio* de este repo)
# Instancia (ej.: localhost\SQLEXPRESS, mi-server\INSTANCIA)
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=precios-supermercados-etl
# Vacío = Windows Auth (Trusted_Connection). Si usás usuario SQL, completar ambos.
SQL_USERNAME=
SQL_PASSWORD=

# HTTP (scrapers de catálogos)
USER_AGENT=precios-supermercados-etl/0.1 (+https://github.com/Nicaleluc/precios-supermercados-etl)
HTTP_TIMEOUT=20
HTTP_REINTENTOS=3
HTTP_PAUSA=0.5

# CADENAS habilitadas (ids de etl/dominios/precios/constants.py)
CADENAS=vea,jumbo,disco,carrefour,changomas,cordiez,dia,cooperativa_obrera,la_banderita

# Paginación del extract de búsqueda
POR_PAGINA=50
MAX_PAGINAS=5
